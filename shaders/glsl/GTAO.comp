#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D NormalGbuffer;
layout(set = 0, binding = 1) uniform sampler2D DepthGbuffer;
layout(set = 1, binding = 0, r32f) writeonly uniform image2D outAO;
layout(std140, set = 2, binding = 0) uniform PerFrameCB
{
    mat4 viewMatrix;
    mat4 projMatrix;
    mat4 invViewProjection;
    vec3 cameraPos;
    float pointLightNumber;
} uboPerFrame;

const vec2 SampleDirections[8] = vec2[](
    vec2(1.0, 0.0),
    vec2(-1.0, 0.0),
    vec2(0.0, 1.0),
    vec2(0.0, -1.0),
    vec2(0.707, 0.707),
    vec2(-0.707, 0.707),
    vec2(0.707, -0.707),
    vec2(-0.707, -0.707)
);

vec3 ReconstructWorldPosition(vec2 uv, float depth)
{
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 clip = vec4(ndc, depth, 1.0);
    vec4 world = uboPerFrame.invViewProjection * clip;
    return world.xyz / world.w;
}

float ViewDepth(vec3 worldPos)
{
    return abs((uboPerFrame.viewMatrix * vec4(worldPos, 1.0)).z);
}

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(outAO);
    if (px.x >= extent.x || px.y >= extent.y)
    {
        return;
    }

    vec2 uv = (vec2(px) + 0.5) / vec2(extent);
    float depth = textureLod(DepthGbuffer, uv, 0.0).r;
    if (depth >= 0.99999)
    {
        imageStore(outAO, px, vec4(1.0));
        return;
    }

    vec3 worldPos = ReconstructWorldPosition(uv, depth);
    float centerDepth = ViewDepth(worldPos);
    vec3 normal = normalize(textureLod(NormalGbuffer, uv, 0.0).xyz);

    float occlusion = 0.0;
    float sampleCount = 0.0;
    vec2 texel = 1.0 / vec2(extent);
    for (uint ring = 1; ring <= 3; ++ring)
    {
        float radius = 2.0 + float(ring) * 3.0;
        for (uint dirIndex = 0; dirIndex < 8; ++dirIndex)
        {
            vec2 sampleUv = clamp(uv + SampleDirections[dirIndex] * texel * radius, vec2(0.0), vec2(1.0));
            float sampleDepth = textureLod(DepthGbuffer, sampleUv, 0.0).r;
            if (sampleDepth < 0.99999)
            {
                vec3 sampleWorld = ReconstructWorldPosition(sampleUv, sampleDepth);
                vec3 toSample = sampleWorld - worldPos;
                float sampleViewDepth = ViewDepth(sampleWorld);
                float facing = clamp(dot(normal, normalize(toSample)) * 0.5 + 0.5, 0.0, 1.0);
                float closeEnough = clamp(1.0 - abs(sampleViewDepth - centerDepth) / 3.0, 0.0, 1.0);
                occlusion += sampleViewDepth < centerDepth - 0.02 ? facing * closeEnough : 0.0;
            }
            sampleCount += 1.0;
        }
    }

    float ao = clamp(1.0 - occlusion / max(sampleCount, 1.0) * 1.8, 0.0, 1.0);
    imageStore(outAO, px, vec4(ao));
}

